<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <!-- 系统审计日志表 -->
    <createTable tableName="sys_audit_log">
        <column name="id" type="bigint" autoIncrement="true">
            <constraints primaryKey="true"/>
        </column>
        <column name="user_id" type="bigint">
            <constraints nullable="true"/>
        </column>
        <column name="username" type="varchar(100)">
            <constraints nullable="true"/>
        </column>
        <column name="module" type="varchar(100)">
            <constraints nullable="false"/>
        </column>
        <column name="action" type="varchar(50)">
            <constraints nullable="false"/>
        </column>
        <column name="description" type="varchar(500)">
            <constraints nullable="true"/>
        </column>
        <column name="request_method" type="varchar(10)">
            <constraints nullable="true"/>
        </column>
        <column name="request_url" type="varchar(500)">
            <constraints nullable="true"/>
        </column>
        <column name="request_params" type="text">
            <constraints nullable="true"/>
        </column>
        <column name="ip_address" type="varchar(50)">
            <constraints nullable="true"/>
        </column>
        <column name="user_agent" type="varchar(500)">
            <constraints nullable="true"/>
        </column>
        <column name="operation_status" type="varchar(20)">
            <constraints nullable="false" defaultValue="SUCCESS"/>
        </column>
        <column name="error_message" type="varchar(1000)">
            <constraints nullable="true"/>
        </column>
        <column name="execution_time" type="bigint">
            <constraints nullable="true"/>
        </column>
        <column name="create_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
            <constraints nullable="false"/>
        </column>
    </createTable>

    <!-- 创建索引 -->
    <createIndex indexName="idx_audit_user_id" tableName="sys_audit_log">
        <column name="user_id"/>
    </createIndex>

    <createIndex indexName="idx_audit_module" tableName="sys_audit_log">
        <column name="module"/>
    </createIndex>

    <createIndex indexName="idx_audit_create_time" tableName="sys_audit_log">
        <column name="create_time"/>
    </createIndex>

    <createIndex indexName="idx_audit_action" tableName="sys_audit_log">
        <column name="action"/>
    </createIndex>

</databaseChangeLog>