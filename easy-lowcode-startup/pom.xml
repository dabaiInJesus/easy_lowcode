<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.dabai</groupId>
        <artifactId>easy-lowcode</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>easy-lowcode-startup</artifactId>
    <packaging>jar</packaging>
    <name>easy-lowcode-startup</name>
    <description>启动模块 - 应用启动入口</description>

    <dependencies>
        <!-- 认证授权模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-auth</artifactId>
        </dependency>

        <!-- AI 模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-ai</artifactId>
        </dependency>

        <!-- 资源查询模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-resource</artifactId>
        </dependency>

        <!-- 可视化大屏模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-dashboard</artifactId>
        </dependency>

        <!-- 数据采集模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-collector</artifactId>
        </dependency>

        <!-- ETL模块 -->
        <dependency>
            <groupId>com.dabai</groupId>
            <artifactId>easy-lowcode-etl</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot DevTools (开发时热重载) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
