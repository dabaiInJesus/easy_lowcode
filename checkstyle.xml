<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle 配置 - 基于 Google Java Style 简化版
    文档：https://checkstyle.org/index.html
-->
<module name="Checker">
    <!-- 行长度限制 120 -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a]*href|href|http://|https://|ftp://"/>
    </module>

    <!-- 禁止尾随空格 -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>

    <!-- 文件必须以换行符结尾 -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <!-- 禁止文件超过 2000 行 -->
    <module name="FileLength">
        <property name="max" value="2000"/>
    </module>

    <module name="TreeWalker">
        <!-- ========== 命名规范 ========== -->
        <!-- 包名：全小写 -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- 类名：UpperCamelCase -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 方法名：lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 参数名：lowerCamelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 局部变量名：lowerCamelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 成员变量名：lowerCamelCase -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 常量名：UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$|^log$|^serialVersionUID$"/>
        </module>

        <!-- ========== 导入规范 ========== -->
        <!-- 禁止星号导入 -->
        <module name="AvoidStarImport"/>

        <!-- 未使用的导入 -->
        <module name="UnusedImports"/>

        <!-- 重复导入 -->
        <module name="RedundantImport"/>

        <!-- ========== 编码规范 ========== -->
        <!-- 禁止魔法数字（忽略常见数字） -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1,0,1,2,3,100,200,500,1000"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
            <property name="ignoreMethod" value="true"/>
        </module>

        <!-- 禁止空的 if/else/try 块 -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
        </module>

        <!-- 禁止嵌套赋值 -->
        <module name="NestedAssignment"/>

        <!-- 禁止深层嵌套（最大 4 层） -->
        <module name="NestedDepth">
            <property name="max" value="4"/>
        </module>

        <!-- ========== 代码风格 ========== -->
        <!-- 左大括号位置 -->
        <module name="LeftCurly"/>

        <!-- 右大括号位置 -->
        <module name="RightCurly"/>

        <!-- 圆括号间距 -->
        <module name="ParenPad"/>

        <!-- 类型转换间距 -->
        <module name="TypecastParenPad"/>

        <!-- 禁止使用 System.out/System.err -->
        <module name="AvoidSystemOut">
            <property name="message" value="Use logger instead of System.out."/>
        </module>

        <module name="AvoidSystemErr">
            <property name="message" value="Use logger instead of System.err."/>
        </module>

        <!-- ========== 注释规范 ========== -->
        <!-- 公共类必须有 Javadoc -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
        </module>
    </module>
</module>
