<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="019-create-sys-role-resource-table" author="dabai">
        <createTable tableName="sys_role_resource" remarks="角色资源关联表">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint columnNames="role_id,resource_id" constraintName="uk_role_resource" tableName="sys_role_resource"/>
        <createIndex indexName="idx_role_resource_role" tableName="sys_role_resource">
            <column name="role_id"/>
        </createIndex>
        <createIndex indexName="idx_role_resource_resource" tableName="sys_role_resource">
            <column name="resource_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
