<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="033-create-fulltext-document-table" author="dabai">
        <validCheckSum>ANY</validCheckSum>

        <createTable tableName="collector_fulltext_document" remarks="全文索引文档表">
            <column name="id" type="BIGINT" remarks="主键ID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(500)" remarks="文件名">
                <constraints nullable="false"/>
            </column>
            <column name="file_type" type="VARCHAR(50)" remarks="文件类型(MIME)"/>
            <column name="file_size" type="BIGINT" remarks="文件大小(bytes)"/>
            <column name="storage_type" type="VARCHAR(20)" defaultValue="minio" remarks="存储类型: minio/s3/local"/>
            <column name="storage_path" type="VARCHAR(1000)" remarks="存储路径"/>
            <column name="content_text" type="TEXT" remarks="Tika提取的纯文本内容(降级用)"/>
            <column name="resource_code" type="VARCHAR(100)" remarks="关联资源编码"/>
            <column name="search_engine" type="VARCHAR(20)" defaultValue="meilisearch" remarks="搜索引擎: meilisearch/elasticsearch"/>
            <column name="indexed" type="SMALLINT" defaultValueNumeric="0" remarks="索引状态: 0-待索引, 1-已索引, 2-索引失败"/>
            <column name="index_error" type="VARCHAR(500)" remarks="索引失败原因"/>
            <column name="deleted" type="INT" defaultValueNumeric="0" remarks="删除标志"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="BIGINT"/>
            <column name="update_by" type="BIGINT"/>
        </createTable>

        <createIndex indexName="idx_fd_indexed" tableName="collector_fulltext_document">
            <column name="indexed"/>
        </createIndex>
        <createIndex indexName="idx_fd_resource_code" tableName="collector_fulltext_document">
            <column name="resource_code"/>
        </createIndex>
        <createIndex indexName="idx_fd_file_type" tableName="collector_fulltext_document">
            <column name="file_type"/>
        </createIndex>

        <comment>全文索引文档表，存储上传文件信息及Tika提取的文本内容</comment>
    </changeSet>

    <changeSet id="033-create-fulltext-index-config-table" author="dabai">
        <validCheckSum>ANY</validCheckSum>

        <createTable tableName="collector_fulltext_index_config" remarks="全文索引配置表">
            <column name="id" type="BIGINT" remarks="主键ID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="resource_code" type="VARCHAR(100)" remarks="表资源编码(空=全局配置)"/>
            <column name="field_name" type="VARCHAR(100)" remarks="字段名">
                <constraints nullable="false"/>
            </column>
            <column name="indexed" type="SMALLINT" defaultValueNumeric="1" remarks="是否参与索引: 0-否, 1-是"/>
            <column name="search_engine" type="VARCHAR(20)" defaultValue="meilisearch" remarks="搜索引擎"/>
            <column name="weight" type="FLOAT" defaultValueNumeric="1.0" remarks="搜索权重"/>
            <column name="deleted" type="INT" defaultValueNumeric="0"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint columnNames="resource_code, field_name"
                             constraintName="uk_ftic_resource_field"
                             tableName="collector_fulltext_index_config"/>

        <comment>全文索引配置表，配置哪些资源的哪些字段参与全文索引</comment>
    </changeSet>
</databaseChangeLog>
