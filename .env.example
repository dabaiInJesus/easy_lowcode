# =============================================
# Easy Lowcode - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# =============================================

# PostgreSQL 数据库密码（必须设置）
POSTGRES_PASSWORD=your_secure_db_password

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_DB=easy_lowcode

# Redis 密码（可选，无密码则留空）
REDIS_PASSWORD=

# AI API Keys（必须至少配置一个）
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MINIMAX_API_KEY=your-minimax-api-key

# AI 默认供应商（选填，例如 dashscope / openai / deepseek）
AI_DEFAULT_PROVIDER=dashscope

# CORS 允许的来源（生产环境建议填写具体域名，例如 https://yourdomain.com）
# 开发环境可填 ** 允许所有
CORS_ORIGINS=**
