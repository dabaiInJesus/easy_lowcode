# =============================================
# Easy Lowcode - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# =============================================

# PostgreSQL 容器配置（docker-compose 使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=easy_lowcode

# 数据库连接配置（Spring Boot 数据源，默认映射至 DB_* 变量）
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=postgres123

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RocketMQ 配置（选填，默认 localhost:9876）
ROCKETMQ_NAMESERVER=localhost:9876

# AI API Keys（必须至少配置一个）
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MINIMAX_API_KEY=your-minimax-api-key

# AI 默认供应商（选填，例如 dashscope / openai / deepseek / minimax）
AI_DEFAULT_PROVIDER=dashscope

# JWT 密钥（必须设置，用于 Token 签名和验证）
# 建议使用至少 32 字符的随机字符串，例如: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-at-least-32-characters

# AES 加密密钥（必须设置，用于敏感数据加密）
# 建议使用 16/24/32 字符的随机字符串，例如: openssl rand -base64 24
ENCRYPT_AES_KEY=your-encrypt-aes-key-16-or-24-or-32-chars

# CORS 允许的来源（生产环境建议填写具体域名，例如 https://yourdomain.com）
# 开发环境可填 ** 允许所有
CORS_ORIGINS=**
