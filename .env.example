# =============================================
# Easy Lowcode - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# 说明:
#   - 应用启动时由 dotenv-java 自动加载; docker-compose 自动读取做变量插值
#   - 优先级: 系统环境变量 > .env > application.yaml 默认值
#   - ⚠️ 值中含 # 或 $ 等特殊字符时必须用双引号包裹
#     （dotenv-java 会截断 # 后内容; 单引号不剥除, 引号会混进值里）
# =============================================

# ---------- PostgreSQL 容器（docker-compose 本地起库时用） ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=easy_lowcode

# ---------- 应用数据源 ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- RocketMQ ----------
ROCKETMQ_NAMESERVER=localhost:9876

# ---------- 全文检索引擎（meilisearch | elasticsearch） ----------
SEARCH_ENGINE=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_NAME=fulltext_docs
# 引擎切 elasticsearch 时使用:
# ES_HOST=localhost:9200
# ES_USERNAME=
# ES_PASSWORD=

# ---------- 文件存储（minio | s3 | local） ----------
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=easy-lowcode-files
# 存储切 S3 / 本地目录时使用:
# S3_ENDPOINT=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# LOCAL_STORAGE_PATH=./data/files

# ---------- AI API Keys（必须至少配置一个） ----------
AI_DEFAULT_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MINIMAX_API_KEY=your-minimax-api-key
# 可选覆盖项（留空用 application.yaml 默认）:
# OPENAI_BASE_URL= / OPENAI_MODEL= / DASHSCOPE_MODEL=
# DEEPSEEK_BASE_URL= / DEEPSEEK_MODEL= / MINIMAX_BASE_URL= / MINIMAX_MODEL=
# WENXIN_API_KEY= / WENXIN_SECRET_KEY=
# OLLAMA_BASE_URL= / OLLAMA_MODEL=

# ---------- 安全密钥 ----------
# JWT 签名密钥（≥32字符）: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
# AES 加密密钥（必须恰好 16 位! EncryptUtil 强校验）: openssl rand -hex 8
ENCRYPT_AES_KEY=your-aes-key-16chars

# ---------- CORS（网关模块用） ----------
# 生产环境建议填写具体域名; 开发环境可填 ** 允许所有
CORS_ORIGINS=**
